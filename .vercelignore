# Deploys from this directory go up through the Vercel CLI, which uploads every
# file git doesn't ignore — including untracked local material. Keep that out.

# Investor financial model — private, never leaves this machine
finmodel/

# Legacy duplicate of the site kept for reference (~250 MB)
cleanvent-nextjs/

# Internal notes and editor state
docs/
*.code-workspace

# Nothing under public/fonts is loaded — the wordmark ships as a woff2 subset
# from src/fonts — and everything under public/ is served publicly.
public/fonts/

# Design handoff: 35 MB of prototypes and photo duplicates, not part of the site
design_handoff_vent_landing/
